<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BNB</title>
  </head>
  <body>
    <footer class="bg-body-secondary text-muted py-4 mt-auto border-top">
      <div
        class="container d-flex flex-column flex-md-row justify-content-between align-items-center"
      >
        <!-- Brand / Copyright -->
        <div class="mb-3 mb-md-0 text-center text-md-start">
          <span>&copy; BNB Private Limited</span>
        </div>

        <!-- Social Media Icons -->
        <div class="f-socials mb-3 mb-md-0 fs-5">
          <a
            href="https://facebook.com"
            target="_blank"
            class="text-muted me-3"
            aria-label="Facebook"
            ><i class="fa-brands fa-square-facebook"></i
          ></a>
          <a
            href="https://instagram.com"
            target="_blank"
            class="text-muted me-3"
            aria-label="Instagram"
            ><i class="fa-brands fa-square-instagram"></i
          ></a>
          <a
            href="https://linkedin.com"
            target="_blank"
            class="text-muted"
            aria-label="LinkedIn"
            ><i class="fa-brands fa-linkedin"></i
          ></a>
        </div>

        <!-- Privacy & Terms Links -->
        <div class="f-info-links">
          <a href="/privacy" class="text-muted text-decoration-none me-3"
            >Privacy</a
          >
          <a href="/terms" class="text-muted text-decoration-none">Terms</a>
        </div>
      </div>
    </footer>
  </body>
</html>
