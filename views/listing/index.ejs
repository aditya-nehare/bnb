<% layout("/layouts/Boilerplate") %>

<h3 class="mt-3 mb-4 fw-semibold">All Listings</h3>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
  <% for (let ls of list) { %>
    <div class="col">
      <a href="/listings/<%= ls._id %>" class="text-decoration-none text-dark">
        <div class="card h-100 border-0 listing-card">
          <!-- Image handling: supports both object (ls.image.url) and string (ls.image) formats -->
          <img
            src="<%= ls.image && ls.image.url ? ls.image.url : (ls.image || 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=60') %>"
            class="card-img-top rounded-3"
            alt="<%= ls.title %>"
            style="height: 20rem; object-fit: cover;"
          >
          <div class="card-body px-1 py-2">
            <p class="card-text mb-0">
              <b><%= ls.title %></b>
            </p>
            <p class="text-muted small mb-1">
              <%= ls.location %>, <%= ls.country %>
            </p>
            <p class="card-text mb-0">
              &#8377; <%= ls.price ? ls.price.toLocaleString("en-IN") : "N/A" %> <span class="text-muted fw-normal">/ night</span>
            </p>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>
