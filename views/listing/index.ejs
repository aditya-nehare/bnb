<% layout("/layouts/Boilerplate") %>

<!-- Category Filter Bar & Tax Switch -->
<div class="filters-container d-flex align-items-center justify-content-between gap-3 mt-3 mb-4 overflow-hidden">
  <div id="filters" class="d-flex align-items-center gap-4 overflow-x-auto py-2">
    <div class="filter text-center text-secondary active">
      <div><i class="fa-solid fa-fire fs-5"></i></div>
      <p class="mb-0 small fw-medium">Trending</p>
    </div>
    <div class="filter text-center text-secondary">
      <div><i class="fa-solid fa-bed fs-5"></i></div>
      <p class="mb-0 small fw-medium">Rooms</p>
    </div>
    <div class="filter text-center text-secondary">
      <div><i class="fa-solid fa-mountain-city fs-5"></i></div>
      <p class="mb-0 small fw-medium">Iconic cities</p>
    </div>
    <div class="filter text-center text-secondary">
      <div><i class="fa-solid fa-mountain fs-5"></i></div>
      <p class="mb-0 small fw-medium">Mountains</p>
    </div>
    <div class="filter text-center text-secondary">
      <div><i class="fa-brands fa-fort-awesome fs-5"></i></div>
      <p class="mb-0 small fw-medium">Castles</p>
    </div>
    <div class="filter text-center text-secondary">
      <div><i class="fa-solid fa-person-swimming fs-5"></i></div>
      <p class="mb-0 small fw-medium">Amazing pools</p>
    </div>
    <div class="filter text-center text-secondary">
      <div><i class="fa-solid fa-campground fs-5"></i></div>
      <p class="mb-0 small fw-medium">Camping</p>
    </div>
    <div class="filter text-center text-secondary">
      <div><i class="fa-solid fa-cow fs-5"></i></div>
      <p class="mb-0 small fw-medium">Farms</p>
    </div>
    <div class="filter text-center text-secondary">
      <div><i class="fa-regular fa-snowflake fs-5"></i></div>
      <p class="mb-0 small fw-medium">Arctic</p>
    </div>
  </div>
</div>

<!-- Search Query Notice (if user searched) -->
<% if (typeof searchQuery !== "undefined" && searchQuery) { %>
  <div class="d-flex align-items-center justify-content-between mb-3">
    <p class="text-muted mb-0">Showing results for "<b><%= searchQuery %></b>"</p>
    <a href="/listings" class="btn btn-sm btn-outline-secondary rounded-pill">Clear filter</a>
  </div>
<% } %>

<!-- Listings Grid -->
<% if (list && list.length > 0) { %>
  <div class="row row-cols-xxl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mb-5">
    <% for (let ls of list) { %>
      <div class="col">
        <a href="/listings/<%= ls._id %>" class="text-decoration-none text-dark">
          <div class="card h-100 border-0 listing-card bg-transparent">

            <!-- Image Wrapper with rounded corners & hover effect -->
            <div class="card-img-wrapper position-relative overflow-hidden rounded-4 shadow-sm mb-2">
              <img
                src="<%= ls.image && ls.image.url ? ls.image.url : (ls.image || 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=60') %>"
                class="card-img-top listing-img"
                alt="<%= ls.title %>"
                loading="lazy"
              >
            </div>

            <!-- Card Information -->
            <div class="card-body p-1">
              <div class="d-flex justify-content-between align-items-start">
                <p class="card-title fw-bold mb-1 text-truncate" style="max-width: 85%;">
                  <%= ls.title %>
                </p>
                <div class="d-flex align-items-center small gap-1 text-dark">
                  <i class="fa-solid fa-star text-dark fs-7"></i>
                  <span>New</span>
                </div>
              </div>

              <p class="text-muted small mb-1 text-truncate">
                <%= ls.location %>, <%= ls.country %>
              </p>

              <!-- Dynamic Price Display -->
              <p class="card-text mb-0 mt-1">
                <span class="base-price fw-bold text-dark">
                  &#8377; <%= ls.price ? ls.price.toLocaleString("en-IN") : "0" %>
                </span>
                <span class="tax-price fw-bold text-dark d-none">
                  &#8377; <%= ls.price ? Math.round(ls.price * 1.18).toLocaleString("en-IN") : "0" %>
                </span>
                <span class="text-muted fw-normal small">/ night</span>
                <span class="tax-info text-muted small ms-1 d-none">&nbsp;(incl. 18% GST)</span>
              </p>
            </div>

          </div>
        </a>
      </div>
    <% } %>
  </div>
<% } else { %>
  <!-- Empty State fallback -->
  <div class="text-center py-5 my-5">
    <i class="fa-regular fa-compass fa-3x text-muted mb-3"></i>
    <h4 class="fw-bold text-dark">No listings found</h4>
    <p class="text-muted">Try adjusting your search criteria or explore all homes.</p>
    <a href="/listings" class="btn btn-dark rounded-pill px-4 py-2 mt-2">Explore All Listings</a>
  </div>
<% } %>
