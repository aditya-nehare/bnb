<% layout("/layouts/Boilerplate") %>

<div class="row mt-4">
  <div class="col-8 offset-2">
    <h3 class="fw-semibold mb-3"><%= listing.title %></h3>
  </div>

  <div class="card col-8 offset-2 border-0 show-card listing-card">
    <!-- Image handles both object {url: '...'} and plain string format -->
    <img
      src="<%= listing.image && listing.image.url ? listing.image.url : (listing.image || 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=60') %>"
      class="card-img-top show-img rounded-3"
      alt="<%= listing.title %>"
      style="height: 22rem; object-fit: cover"
    />
    <div class="card-body px-0 py-3">
      <p class="card-text text-secondary mb-2"><%= listing.description %></p>

      <p class="card-text fs-5 mb-1">
        <b
          >&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") :
          "N/A" %></b
        >
        <span class="text-muted fs-6 fw-normal">/ night</span>
      </p>

      <p class="card-text text-muted mb-0">
        <i class="fa-solid fa-location-dot me-1"></i> <%= listing.location %>,
        <%= listing.country %>
      </p>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="col-8 offset-2 d-flex gap-3 mb-5">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark px-4">
      Edit
    </a>

    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
      <button
        class="btn btn-outline-danger px-4"
        onclick="
          return confirm('Are you sure you want to delete this listing?');
        "
      >
        Delete
      </button>
    </form>
  </div>
</div>
