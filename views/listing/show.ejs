<% layout("/layouts/Boilerplate") %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-4 mb-5">
  <!-- Title & Owner Header -->
  <div class="col-lg-10 offset-lg-1">
    <h2 class="fw-bold mb-1 text-dark"><%= listing.title %></h2>
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
      <p class="text-muted mb-0 small">
        <i class="fa-solid fa-location-dot text-danger me-1"></i>
        <span class="fw-medium text-dark"><%= listing.location %></span>, <%= listing.country %>
        &nbsp;•&nbsp;
        <span>Hosted by <b><%= listing.owner ? listing.owner.username : "Host" %></b></span>
      </p>

      <!-- Action Buttons (Edit / Delete) for Host -->
      <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
        <div class="d-flex align-items-center gap-2">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark btn-sm rounded-pill px-3">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0">
            <button class="btn btn-outline-danger btn-sm rounded-pill px-3">
              <i class="fa-solid fa-trash me-1"></i> Delete
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Hero Image Showcase -->
  <div class="col-lg-10 offset-lg-1 mb-4">
    <div class="position-relative overflow-hidden rounded-4 shadow-sm" style="max-height: 30rem;">
      <img
        src="<%= listing.image.url %>"
        class="img-fluid w-100 object-fit-cover"
        alt="<%= listing.title %>"
        style="height: 30rem; object-fit: cover;"
      />
    </div>
  </div>

  <!-- Main Content Split (Left: Details | Right: Sticky Booking Card) -->
  <div class="col-lg-10 offset-lg-1">
    <div class="row g-5">

      <!-- Left Column: Place Information -->
      <div class="col-lg-7">
        <div class="d-flex align-items-center justify-content-between pb-4 border-bottom">
          <div>
            <h4 class="fw-bold mb-1">Entire home in <%= listing.location %></h4>
            <span class="text-muted small">4 guests &nbsp;•&nbsp; 2 bedrooms &nbsp;•&nbsp; 2 beds &nbsp;•&nbsp; 2 baths</span>
          </div>
          <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 48px; height: 48px;">
            <i class="fa-solid fa-user"></i>
          </div>
        </div>

        <!-- Airbnb Highlights -->
        <div class="py-4 border-bottom">
          <div class="d-flex gap-3 mb-3">
            <i class="fa-solid fa-door-open fs-5 text-secondary mt-1"></i>
            <div>
              <h6 class="fw-semibold mb-0">Self check-in</h6>
              <p class="text-muted small mb-0">Check yourself in with the digital keypad.</p>
            </div>
          </div>
          <div class="d-flex gap-3">
            <i class="fa-solid fa-calendar-xmark fs-5 text-secondary mt-1"></i>
            <div>
              <h6 class="fw-semibold mb-0">Free cancellation</h6>
              <p class="text-muted small mb-0">Cancel up to 48 hours before check-in for a full refund.</p>
            </div>
          </div>
        </div>

        <!-- Description -->
        <div class="py-4 border-bottom">
          <h5 class="fw-bold mb-3">About this place</h5>
          <p class="text-secondary" style="line-height: 1.8; font-size: 0.98rem;">
            <%= listing.description %>
          </p>
        </div>

        <!-- Amenities Preview -->
        <div class="py-4 border-bottom">
          <h5 class="fw-bold mb-3">What this place offers</h5>
          <div class="row row-cols-2 g-3 text-secondary">
            <div class="col d-flex align-items-center gap-2"><i class="fa-solid fa-wifi"></i> Fast Wi-Fi</div>
            <div class="col d-flex align-items-center gap-2"><i class="fa-solid fa-car"></i> Free parking</div>
            <div class="col d-flex align-items-center gap-2"><i class="fa-solid fa-snowflake"></i> Air conditioning</div>
            <div class="col d-flex align-items-center gap-2"><i class="fa-solid fa-kitchen-set"></i> Dedicated workspace</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Sticky Booking Widget -->
      <div class="col-lg-5">
        <div class="sticky-top" style="top: 100px; z-index: 10;">
          <div class="card border rounded-4 shadow-sm p-4 bg-white">
            <div class="d-flex justify-content-between align-items-baseline mb-4">
              <div>
                <span class="fs-3 fw-bold text-dark">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></span>
                <span class="text-muted small">/ night</span>
              </div>
              <div class="small fw-semibold">
                <i class="fa-solid fa-star text-danger"></i>
                <span><%= listing.reviews.length ? (listing.reviews.reduce((acc, r) => acc + r.rating, 0) / listing.reviews.length).toFixed(1) : "New" %></span>
              </div>
            </div>

            <!-- Fake Check-in / Guest Box (UI only) -->
            <div class="border rounded-3 mb-3 overflow-hidden">
              <div class="row g-0 border-bottom">
                <div class="col-6 p-2 border-end">
                  <label class="d-block text-uppercase fw-bold text-muted" style="font-size: 0.65rem;">Check-in</label>
                  <small class="fw-medium">Add date</small>
                </div>
                <div class="col-6 p-2">
                  <label class="d-block text-uppercase fw-bold text-muted" style="font-size: 0.65rem;">Checkout</label>
                  <small class="fw-medium">Add date</small>
                </div>
              </div>
              <div class="p-2">
                <label class="d-block text-uppercase fw-bold text-muted" style="font-size: 0.65rem;">Guests</label>
                <small class="fw-medium">1 guest</small>
              </div>
            </div>

            <button class="btn btn-danger w-100 py-2 rounded-3 fw-semibold shadow-sm" style="background-color: #fe424d; border: none;">
              Reserve
            </button>
            <p class="text-center text-muted small mt-2 mb-0">You won't be charged yet</p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Map Display Section -->
  <div class="col-lg-10 offset-lg-1 mt-5">
    <hr class="text-muted opacity-25 mb-4" />
    <h4 class="fw-bold mb-2">Where you'll be</h4>
    <p class="text-muted small mb-3"><%= listing.location %>, <%= listing.country %></p>
    <div id="map" style="height: 420px; width: 100%; border-radius: 16px;"></div>
  </div>

  <!-- Reviews Section -->
  <div class="col-lg-10 offset-lg-1 mt-5">
    <hr class="text-muted opacity-25 mb-5" />

    <div class="d-flex align-items-center gap-2 mb-4">
      <h3 class="fw-bold mb-0">
        <i class="fa-solid fa-star text-danger me-1"></i>
        <%= listing.reviews.length ? (listing.reviews.reduce((acc, r) => acc + r.rating, 0) / listing.reviews.length).toFixed(1) : "No reviews yet" %>
        &nbsp;•&nbsp;
        <%= listing.reviews.length %> <%= listing.reviews.length === 1 ? 'review' : 'reviews' %>
      </h3>
    </div>

    <!-- Review Form (Only for logged-in users) -->
    <% if (currUser) { %>
      <div class="bg-light p-4 rounded-4 border mb-5">
        <h5 class="fw-bold mb-3">Leave a review</h5>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">

          <!-- Interactive Star Rating Fieldset -->
          <div class="mb-3">
            <label class="form-label fw-medium text-secondary small d-block">Overall rating</label>
            <fieldset class="starability-slot">

              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <div class="mb-3">
            <label for="comment" class="form-label fw-medium text-secondary small">Comments</label>
            <textarea
              name="review[comment]"
              id="comment"
              rows="3"
              class="form-control rounded-3 bg-white"
              placeholder="What made your stay special?"
              required
            ></textarea>
            <div class="invalid-feedback">Please share a brief comment about your stay.</div>
          </div>

          <button type="submit" class="btn btn-dark px-4 py-2 rounded-pill fw-medium small">
            Submit Review
          </button>
        </form>
      </div>
    <% } %>

    <!-- Reviews Grid -->
    <% if (listing.reviews && listing.reviews.length > 0) { %>
      <div class="row row-cols-1 row-cols-md-2 g-4">
        <% for (let review of listing.reviews) { %>
          <div class="col">
            <div class="card border-0 rounded-4 h-100 p-2 bg-transparent">
              <div class="card-body p-2">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                      <i class="fa-solid fa-user"></i>
                    </div>
                    <div>
                      <h6 class="mb-0 fw-bold text-dark"><%= review.author ? review.author.username : "Guest" %></h6>
                      <small class="text-muted" style="font-size: 0.75rem;">Verified Stay</small>
                    </div>
                  </div>

                  <!-- Starability static result display -->
                  <p class="starability-result m-0" data-rating="<%= review.rating %>"></p>
                </div>

                <p class="card-text text-secondary mb-2" style="font-size: 0.95rem; line-height: 1.6;">
                  <%= review.comment %>
                </p>

                <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                  <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-2">
                    <button class="btn btn-link text-danger p-0 small text-decoration-none" style="font-size: 0.8rem;">
                      Delete review
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>

  </div>
</div>

<script src="/js/map.js"></script>
