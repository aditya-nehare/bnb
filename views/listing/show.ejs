<% layout("/layouts/Boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1">
    <h2 class="fw-bold mb-3"><%= listing.title %></h2>
  </div>

  <div
    class="card col-lg-8 offset-lg-2 col-md-10 offset-md-1 border-0 shadow-sm rounded-4 overflow-hidden mb-4 listing-card"
  >
    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="<%= listing.title %>"
      style="height: 28rem; object-fit: cover"
    />
    <div class="card-body p-4 bg-white">
      <p class="text-muted mb-2">
        <i class="fa-solid fa-location-dot text-danger me-1"></i>
        <span class="fw-medium text-dark"><%= listing.location %></span>, <%=
        listing.country %>
      </p>

      <hr class="text-muted opacity-25 my-3" />

      <h5 class="fw-semibold text-secondary mb-2">About this place</h5>
      <p class="card-text text-secondary mb-4" style="line-height: 1.7">
        <%= listing.description %>
      </p>

      <div class="d-flex align-items-baseline bg-light p-3 rounded-3">
        <h3 class="fw-bold text-dark mb-0 me-1">
          &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") :
          "N/A" %>
        </h3>
        <span class="text-muted fs-6">/ night</span>
      </div>
    </div>
  </div>

  <!-- Action Buttons (Edit / Delete) -->
  <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1 d-flex gap-3 mb-5">
    <a
      href="/listings/<%= listing._id %>/edit"
      class="btn btn-dark px-4 py-2 rounded-pill shadow-sm fw-medium"
    >
      <i class="fa-solid fa-pen-to-square me-2"></i> Edit
    </a>

    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
      <button
        class="btn btn-outline-danger px-4 py-2 rounded-pill shadow-sm fw-medium"
        onclick="return confirm('Are you sure you want to delete this listing?');"
      >
        <i class="fa-solid fa-trash-can me-2"></i> Delete
      </button>
    </form>
  </div>

  <hr
    class="col-lg-8 offset-lg-2 col-md-10 offset-md-1 text-muted opacity-25 mb-5"
  />

  <!-- Leave a Review Section -->
  <div
    class="col-lg-8 offset-lg-2 col-md-10 offset-md-1 bg-white p-4 p-md-5 rounded-4 shadow-sm border"
  >
    <h4 class="fw-bold mb-4">Leave a Review</h4>

    <form
      action="/listings/<%= listing._id %>/reviews"
      method="POST"
      novalidate
      class="needs-validation"
    >
      <!-- Rating Slider -->
      <div class="mb-4">
        <label for="rating" class="form-label fw-medium text-secondary">Rating</label>
        <input
          type="range"
          min="1"
          max="5"
          id="rating"
          name="review[rating]"
          class="form-range"
        />
        <div class="form-text text-muted">
          Slide to select a rating from 1 to 5 stars.
        </div>
      </div>

      <!-- Comment Textarea -->
      <div class="mb-4">
        <label for="comment" class="form-label fw-medium text-secondary"
          >Comments</label
        >
        <textarea
          name="review[comment]"
          id="comment"
          rows="4"
          class="form-control rounded-3"
          placeholder="Write your experience here..."
          required
        ></textarea>
        <div class="invalid-feedback">
          Please write a short comment before submitting.
        </div>
      </div>

      <button
        type="submit"
        class="btn btn-dark px-4 py-2 rounded-pill fw-medium shadow-sm"
      >
        Submit Review
      </button>
    </form>
  </div>

  <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1 mt-5 mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <h3 class="fw-bold mb-0">
        Reviews (<%= listing.reviews ? listing.reviews.length : 0 %>)
      </h3>
    </div>

    <% if (listing.reviews && listing.reviews.length > 0) { %>
      <div class="row row-cols-1 row-cols-md-2 g-4">
        <% for (let review of listing.reviews) { %>
          <div class="col">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white review-card">
              <div class="card-body d-flex flex-column justify-content-between p-2">

                <div>
                  <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center">
                      <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold me-2" style="width: 38px; height: 38px; font-size: 0.85rem;">
                        <i class="fa-solid fa-user"></i>
                      </div>
                      <div>
                        <h6 class="mb-0 fw-bold text-dark fs-6">Guest</h6>
                        <small class="text-muted" style="font-size: 0.75rem;">Verified Stay</small>
                      </div>
                    </div>

                    <!-- Clean Rating Badge -->
                    <div class="bg-light px-3 py-1 rounded-pill border d-flex align-items-center">
                      <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                        <button>
                          delete
                        </button>
                      </form>
                    </div>
                  </div>

                  <!-- Comment Text -->
                   <div class="bg-light px-3 py-1 rounded-pill border d-flex align-items-center">
                      <span class="fw-bold small text-dark"><%= review.rating %> / 5</span>
                    </div>
                  <p class="card-text text-secondary mb-3" style="font-size: 0.95rem; line-height: 1.6;">
                    "<%= review.comment %>"
                  </p>
                </div>

                <!-- Footer Meta -->
                <div class="text-muted pt-2 border-top border-light" style="font-size: 0.75rem;">
                  <i class="fa-regular fa-clock me-1"></i> Posted recently
                </div>

              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="text-center p-5 bg-light rounded-4 border">
        <i class="fa-regular fa-comment-dots fa-2x text-muted mb-2"></i>
        <p class="text-muted mb-0">No reviews yet. Be the first to share your experience!</p>
      </div>
    <% } %>
  </div>
</div>
