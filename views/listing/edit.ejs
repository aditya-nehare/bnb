<% layout("/layouts/Boilerplate") %>

<div class="row mt-3 mb-5">
  <div class="col-8 offset-2">
    <h3 class="fw-bold mb-4">Edit Listing</h3>

    <form
      action="/listings/<%= listing._id %>?_method=PATCH"
      method="POST"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <!-- Title -->
      <div class="mb-3">
        <label for="title" class="form-label fw-medium">Title</label>
        <input
          id="title"
          name="listing[title]"
          value="<%= listing.title %>"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please enter a valid title.</div>
      </div>

      <!-- Description -->
      <div class="mb-3">
        <label for="description" class="form-label fw-medium"
          >Description</label
        >
        <textarea
          id="description"
          name="listing[description]"
          class="form-control"
          rows="4"
          required
        >
<%= listing.description %></textarea
        >
        <div class="invalid-feedback">Please enter a short description.</div>
      </div>

      <!-- Current Image Preview -->
      <div class="mb-3">
        <label class="form-label fw-medium d-block text-secondary"
          >Original Listing Image</label
        >
        <img
          src="<%= originalImageThumbnail %>"
          alt="Listing image preview"
          class="img-thumbnail rounded-3 shadow-sm"
          style="max-height: 200px; object-fit: cover"
        />
      </div>

      <!-- New Image Upload -->
      <div class="mb-3">
        <label for="image" class="form-label fw-medium"
          >Upload New Image (Optional)</label
        >
        <input
          id="image"
          name="listing[image]"
          type="file"
          class="form-control"
        />
      </div>

      <div class="row">
        <!-- Price -->
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label fw-medium"
            >Price (&#8377; / night)</label
          >
          <input
            id="price"
            name="listing[price]"
            value="<%= listing.price %>"
            type="number"
            class="form-control"
            min="0"
            required
          />
          <div class="invalid-feedback">Please provide a valid price.</div>
        </div>

        <!-- Country -->
        <div class="mb-3 col-md-8">
          <label for="country" class="form-label fw-medium">Country</label>
          <input
            id="country"
            name="listing[country]"
            value="<%= listing.country %>"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please provide a valid country.</div>
        </div>
      </div>

      <!-- Location -->
      <div class="mb-4">
        <label for="location" class="form-label fw-medium">Location</label>
        <input
          id="location"
          name="listing[location]"
          value="<%= listing.location %>"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please provide a valid location.</div>
      </div>

      <button type="submit" class="btn btn-dark px-4 py-2 rounded-3">
        Update Listing
      </button>
      <a
        href="/listings/<%= listing._id %>"
        class="btn btn-outline-secondary px-4 py-2 rounded-3 ms-2"
        >Cancel</a
      >
    </form>
  </div>
</div>
