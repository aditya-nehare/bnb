<% layout("/layouts/Boilerplate") %>

<div class="row mt-5 mb-5">
  <div class="col-md-6 offset-md-3 col-lg-4 offset-lg-4">
    <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">
      <h3 class="fw-bold text-center mb-4">Sign Up on BNB</h3>

      <form action="/signup" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label fw-medium text-secondary"
            >Username</label
          >
          <input
            type="text"
            name="username"
            id="username"
            class="form-control rounded-3"
            required
          />
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Please enter a valid username.</div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label fw-medium text-secondary"
            >Email</label
          >
          <input
            type="email"
            name="email"
            id="email"
            class="form-control rounded-3"
            required
          />
          <div class="invalid-feedback">
            Please enter a valid email address.
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label fw-medium text-secondary"
            >Password</label
          >
          <input
            type="password"
            name="password"
            id="password"
            class="form-control rounded-3"
            required
          />
          <div class="invalid-feedback">Please enter a secure password.</div>
        </div>

        <button
          type="submit"
          class="btn btn-dark w-100 py-2 rounded-pill fw-medium shadow-sm"
        >
          Sign Up
        </button>
      </form>
    </div>
  </div>
</div>
